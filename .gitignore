# -------------------------
# Python / build artifacts
# -------------------------
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/

# -------------------------
# Environments (uv / venv)
# -------------------------
.venv/
.python-version

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb

# -------------------------
# OS / editor
# -------------------------
.DS_Store
Thumbs.db
.vscode/

# -------------------------
# Data (avoid large datasets)
# -------------------------
data/raw/*
data/processed/*
!data/raw/README.md
!data/processed/README.md
!data/processed/.gitkeep

# -------------------------
# ML artifacts (models, outputs)
# -------------------------
artifacts/*
!artifacts/.gitkeep
!artifacts/HistGradientBoosting_tuned.joblib

# -------------------------
# Results / figures
# -------------------------
results/figures/*
!results/figures/.gitkeep

# -------------------------
# Streamlit
# -------------------------
.streamlit/secrets.toml
.streamlit/cache/
.streamlit/.cache/
